# Copie para .env (cp .env.example .env) e preencha. NUNCA envie o .env ao Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=alaga_app
DB_PASSWORD=CHANGE_ME
DB_NAME=alagaalerta

# Tokens: gere com  python -c "import secrets; print(secrets.token_urlsafe(32))"  (mínimo 16 caracteres)
ADMIN_TOKEN=CHANGE_ME
SENSOR_TOKEN=CHANGE_ME

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
UDP_HOST=127.0.0.1
UDP_PORT=9999
LOG_FILE=logs/alagaalerta.log
RATE_LIMIT_POST_POR_MIN=10
